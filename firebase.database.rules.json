{
  "rules": {
    ".read": false,
    ".write": false,
    "public": { ".read": "auth != null", ".write": false },
    "ride_requests": { ".read": "auth != null && auth.token.admin === true", ".write": false },
    "users": {
      "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": false }
    },
    "drivers": {
      "open_rides": { ".read": "auth != null && auth.token.role === 'driver'", ".write": false },
      "$uid": { ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)", ".write": false }
    },
    "admin": { ".read": "auth != null && auth.token.admin === true", ".write": false }
  }
}
